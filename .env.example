# Copy to .env and fill in. Every value is optional; the app runs without any of them.

# CourtListener API token (free): https://www.courtlistener.com/help/api/rest/
# Without a token the app falls back to the anonymous search endpoint, which is
# limited to roughly 10 requests per 36-second window and cannot read opinion text.
COURTLISTENER_TOKEN=

# Base URL of the CourtListener REST API.
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4

# SQLite file used to cache upstream API responses.
CITEPROOF_CACHE_PATH=data/cache/cache.sqlite

# Seconds between upstream requests. Token requests are paced faster than anonymous ones.
CITEPROOF_MIN_INTERVAL_TOKEN=0.15
CITEPROOF_MIN_INTERVAL_ANON=3.6

# LLM used for the proposition-fidelity check. The check is skipped when no key is set.
# Any OpenAI-compatible /chat/completions endpoint works.
CITEPROOF_LLM_API_KEY=
CITEPROOF_LLM_BASE_URL=https://api.deepseek.com
CITEPROOF_LLM_MODEL=deepseek-chat
