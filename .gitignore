.DS_Store
.idea/
.vscode/

# Probe scratch (not part of the project)
.probe/

# Audit reports and generated results are reproducible; do not track them.
data/audits/

# TypeScript incremental build state
*.tsbuildinfo

# Playwright writes intermediate video files here; the published walkthrough is
# docs/demo/citeproof-walkthrough.webm and is tracked.
docs/demo/raw/
